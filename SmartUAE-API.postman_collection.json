            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Software Engineer\",\n  \"company\": \"Nexora Systems\",\n  \"category\": \"IT\",\n  \"location\": \"Dubai, UAE\",\n  \"jobType\": \"Fulltime\",\n  \"experienceLevel\": \"3+ years\"\n}" }
          }
        },
        {
          "name": "AI: Improve Job Description (auth)",
          "request": {
            "method": "POST",
