          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/jobs/ai/generate-qualifications", "host": ["{{baseUrl}}"], "path": ["api", "jobs", "ai", "generate-qualifications"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Software Engineer\",\n  \"experienceLevel\": \"3+ years\"\n}" }
          }
        },
        {
          "name": "AI: Suggest Skills (auth)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/jobs/ai/suggest-skills", "host": ["{{baseUrl}}"], "path": ["api", "jobs", "ai", "suggest-skills"] },
