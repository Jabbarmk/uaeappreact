{
  "info": {
    "name": "SmartUAE API",
    "description": "Public-facing frontend API for smartflix.ae (SmartUAE app): home, businesses, offers, jobs, real estate, classifieds, categories, events, collections, doctors, universities, search, taxonomy, welcome, pages, profiles, auth, and \"my account\" (session-user) endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://smatflix.ae", "type": "string" },
    { "key": "jobId", "value": "1", "type": "string" },
    { "key": "businessId", "value": "1", "type": "string" },
    { "key": "offerId", "value": "1", "type": "string" },
    { "key": "propertyId", "value": "1", "type": "string" },
    { "key": "companyId", "value": "1", "type": "string" },
    { "key": "projectId", "value": "1", "type": "string" },
    { "key": "classifiedId", "value": "1", "type": "string" },
    { "key": "eventId", "value": "1", "type": "string" },
    { "key": "collectionId", "value": "1", "type": "string" },
    { "key": "doctorId", "value": "1", "type": "string" },
    { "key": "universityId", "value": "1", "type": "string" },
    { "key": "courseId", "value": "1", "type": "string" },
    { "key": "profileId", "value": "1", "type": "string" },
    { "key": "applicationId", "value": "1", "type": "string" },
    { "key": "workExperienceId", "value": "1", "type": "string" },
    { "key": "reviewId", "value": "1", "type": "string" },
    { "key": "productId", "value": "1", "type": "string" },
    { "key": "imageId", "value": "1", "type": "string" },
    { "key": "pageSlug", "value": "about", "type": "string" },
    { "key": "categoryId", "value": "1", "type": "string" }
  ],
  "item": [
    {
      "name": "Home",
      "item": [
        {
          "name": "Get Theme Colors",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/home/theme", "host": ["{{baseUrl}}"], "path": ["api", "home", "theme"] } }
        },
        {
          "name": "Get Home Page",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/home", "host": ["{{baseUrl}}"], "path": ["api", "home"] } }
        }
      ]
    },
    {
      "name": "Welcome / Splash",
      "item": [
        {
          "name": "Get Welcome Slides",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/welcome", "host": ["{{baseUrl}}"], "path": ["api", "welcome"] } }
        }
      ]
    },
    {
      "name": "Businesses",
      "item": [
        {
          "name": "List Businesses",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/businesses?cat={{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "businesses"], "query": [{ "key": "cat", "value": "{{categoryId}}", "description": "Optional category id filter" }] } }
        },
        {
          "name": "Search Businesses",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/businesses/search?q=cafe&category_id={{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "search"], "query": [{ "key": "q", "value": "cafe" }, { "key": "category_id", "value": "{{categoryId}}", "description": "optional" }] } }
        },
        {
          "name": "Get Business Detail",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/businesses/{{businessId}}", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "{{businessId}}"] } }
        },
        {
          "name": "Get Business Product Detail",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/businesses/{{businessId}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "{{businessId}}", "products", "{{productId}}"] } }
        },
        {
          "name": "Track Business View",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/businesses/view/{{businessId}}", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "view", "{{businessId}}"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"emirate\": \"Dubai\"\n}" }
          }
        },
        {
          "name": "Add/Update Review (auth)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/businesses/{{businessId}}/reviews", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "{{businessId}}", "reviews"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"rating\": 5,\n  \"review\": \"Great service!\"\n}" }
          }
        },
        {
          "name": "Delete My Review (auth)",
          "request": { "method": "DELETE", "url": { "raw": "{{baseUrl}}/api/businesses/{{businessId}}/reviews", "host": ["{{baseUrl}}"], "path": ["api", "businesses", "{{businessId}}", "reviews"] } }
        }
      ]
    },
    {
      "name": "Offers",
      "item": [
        {
          "name": "List Offers",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/offers?loc=Dubai&cat={{categoryId}}", "host": ["{{baseUrl}}"], "path": ["api", "offers"], "query": [{ "key": "loc", "value": "Dubai" }, { "key": "cat", "value": "{{categoryId}}", "description": "optional" }] } }
        },
        {
          "name": "Get Offer Detail",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/offers/{{offerId}}", "host": ["{{baseUrl}}"], "path": ["api", "offers", "{{offerId}}"] } }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List Jobs (with filters)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/jobs?search=&location=&emirate=Dubai&company=&job_type=Fulltime&work_model=&salary_min=&salary_max=&featured=&posted_within_days=&sort=relevance",
              "host": ["{{baseUrl}}"], "path": ["api", "jobs"],
              "query": [
                { "key": "search", "value": "", "description": "matches title/company/description" },
                { "key": "location", "value": "" },
                { "key": "emirate", "value": "Dubai" },
                { "key": "company", "value": "" },
                { "key": "job_type", "value": "Fulltime" },
                { "key": "work_model", "value": "", "description": "Remote | Hybrid | On-site" },
                { "key": "salary_min", "value": "" },
                { "key": "salary_max", "value": "" },
                { "key": "featured", "value": "", "description": "1 to filter featured only" },
                { "key": "posted_within_days", "value": "" },
                { "key": "sort", "value": "relevance", "description": "relevance | newest | salary" }
              ]
            }
          }
        },
        {
          "name": "Get Job Detail",
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/api/jobs/{{jobId}}", "host": ["{{baseUrl}}"], "path": ["api", "jobs", "{{jobId}}"] } }
