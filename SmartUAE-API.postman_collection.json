          "name": "AI: Generate SEO Content (auth)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/jobs/ai/generate-seo", "host": ["{{baseUrl}}"], "path": ["api", "jobs", "ai", "generate-seo"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Software Engineer\",\n  \"company\": \"Nexora Systems\",\n  \"location\": \"Dubai, UAE\"\n}" }
          }
        }
      ]
