          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/jobs/ai/generate-screening-questions", "host": ["{{baseUrl}}"], "path": ["api", "jobs", "ai", "generate-screening-questions"] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Software Engineer\",\n  \"experienceLevel\": \"3+ years\"\n}" }
          }
